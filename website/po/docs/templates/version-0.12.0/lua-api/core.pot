msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:822
msgid "`stderr` applies to all stages."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:823
msgid ""
"When `check = true`, any failed stage raises a structured `command_failed` "
"error, and `retry = true` prompts to rerun the whole pipeline."
msgstr ""

