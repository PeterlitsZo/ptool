#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:776
msgid "ptool.pipe"
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:778
msgctxt "/Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:778"
msgid "`v0.9.0` - Introduced."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:780
msgid ""
"`ptool.pipe(stages[, options])` executes a local pipeline without invoking a "
"shell."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:783
msgid ""
"`stages` (table, required): Pipeline stage list. At least two stages are "
"required."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:785
msgid "`options` (table, optional): Per-call overrides."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:786
msgid "Returns: A result table similar to `ptool.run(...)`."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:788
msgid "Stage rules:"
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:790
msgid "Each stage can be a command string such as `\"printf hello\"`."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:791
msgid ""
"Each stage can be an array such as `{\"tr\", \"a-z\", \"A-Z\"}` where the "
"first item is the command and the rest are arguments."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:793
msgid ""
"Each stage can be a table such as `{ cmd = \"tr\", args = {\"a-z\", \"A-Z\"} "
"}`."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:794
msgid ""
"Stage command strings and string argslines are split using shell-style "
"(`shlex`) rules, just like `ptool.run(...)`."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:797
msgctxt "/Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:797"
msgid "Return value rules:"
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:799
msgid "`ok` (boolean): Whether every stage exited with status `0`."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:800
msgid ""
"`code` (integer|nil): Summary status for the pipeline. On success this is "
"the last stage status. On failure this is the last non-zero stage status, or "
"`nil` if the relevant stage was terminated by a signal."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:803
msgid "`codes` (integer|nil)[]: Per-stage exit statuses in stage order."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:804
msgid ""
"`cmd` (string): Display form of the whole pipeline, such as ``printf hello | "
"tr a-z A-Z``."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:806
msgid "`cwd` (string): Effective working directory used for the pipeline."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:807
msgid ""
"`stdout` (string, optional): Present when `stdout = \"capture\"`. This "
"captures the stdout of the last stage."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:809
msgid ""
"`stderr` (string, optional): Present when `stderr = \"capture\"`. This "
"combines stderr from all stages in stage order."
msgstr ""

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:811
msgid ""
"`assert_ok(self)` (function): Raises the same structured `command_failed` "
"error shape as `ptool.run(...)` when any stage fails."
