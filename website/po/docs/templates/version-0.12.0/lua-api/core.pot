#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:814
msgctxt "/Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/core.md:814"
msgid "Behavior:"
