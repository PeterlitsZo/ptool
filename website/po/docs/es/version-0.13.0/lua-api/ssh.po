msgstr "existe"

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/ssh.md:387
msgctxt "/Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/ssh.md:387"
msgid "`v0.2.0` - Introduced."
msgstr "`v0.2.0` - Introducido."

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/ssh.md:389
msgid "Canonical API name: `ptool.ssh.Connection:exists`."
msgstr "Canonical API name: `ptool.ssh.Connection:exists`."

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/ssh.md:391
msgid "`conn:exists(path)` checks whether a remote path exists."
msgstr "`conn:exists(path)` comprueba si existe una ruta remota."

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/ssh.md:393
msgctxt "/Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/ssh.md:393"
msgid ""
"`path` (string|remote path, required): The remote path to check. It can be a "
"string or a value created by `conn:path(...)`."
msgstr ""
"`path` (string|remote path, obligatorio): La ruta remota que se debe "
"comprobar. Puede ser una cadena o un valor creado por `conn:path(...)`."

#: /Users/peterlits/Proj/PeterlitsZo/ptool/website/docs/lua-api/ssh.md:395
